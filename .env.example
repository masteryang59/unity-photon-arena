# Copy to .env (gitignored). Only needed for the Photon backend; Offline and LAN work without it.

# Photon Realtime/PUN App ID from https://dashboard.photonengine.com (create a "Pun" application).
# Read at startup and copied into PUN's PhotonServerSettings, so the ID never has to be committed.
PHOTON_APP_ID=

# Optional: pin a region (eu, us, usw, asia, jp, ...) so every tester lands in the same one.
# Empty = PUN picks the best region per player, and players in different regions never see each other.
PHOTON_REGION=

BATCH_INSERT=enabled
BATCH_INSERT=enabled